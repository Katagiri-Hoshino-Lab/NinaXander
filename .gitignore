# local environments and model checkpoints
fla_env/
# converted 7B parent weights (about 27 GB). The conversion helper is not bundled; prepare these before GPU runs.
models/
# trained adapters (164GB as of the z=4096 runs; --keep_every writes a 3.2GB checkpoint every 10k steps) —
# generated by experiments/slurm/train_adapter.sbatch + continue_adapter.sbatch
artifacts/checkpoints/
# per-run provenance outputs (large; regenerable)
artifacts/runs/
artifacts/logs/**
# python
**/__pycache__/
*.pyc
*.pyo
# LaTeX build artifacts (keep .tex and .pdf)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.nav
paper/*.out
paper/*.snm
paper/*.toc
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.dvi
# misc caches
.cache/
.claude/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# the local .env holds a live HF token — every variant/backup copy must stay
# ignored too; only the placeholder template ships.
.env
.env.*
!.env.example

# stray scheduler logs submitted without an explicit -o land at the repo root;
# the intentional locations are already covered by artifacts/logs/**
slurm-*.out
*.log

# virtualenvs, editor and OS junk
.venv/
venv/
.vscode/
.idea/
*.swp
*~
.DS_Store

# Hub release outputs are staged locally for a separate Hugging Face upload;
# the complete package intentionally contains both 7B parents and does not
# belong in the source repository.
/release/
