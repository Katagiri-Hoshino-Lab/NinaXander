# Copy this file to .env and edit it for the local cluster.
# .env is gitignored. Do not commit HF_TOKEN or other secrets.

# Python environment
NINAXANDER_PYTHON=python3
NINAXANDER_TORCHRUN=torchrun

# SLURM site settings. Empty partition values use the scheduler default.
NINAXANDER_SLURM_GPU_PARTITION=
NINAXANDER_SLURM_CPU_PARTITION=
NINAXANDER_SLURM_GPU_CPUS=8
NINAXANDER_SLURM_CPU_CPUS=2

# Set this when the cluster requires an explicit GPU request (for example gpu:4).
# Leave it empty on clusters whose GPU partition allocates GPUs implicitly.
NINAXANDER_SLURM_GRES=
NINAXANDER_SLURM_ACCOUNT=
NINAXANDER_SLURM_QOS=
NINAXANDER_SLURM_CONSTRAINT=

# Four physical GPU indices are used as two model-parallel pairs.
NINAXANDER_GPU_0=0
NINAXANDER_GPU_1=1
NINAXANDER_GPU_2=2
NINAXANDER_GPU_3=3
NINAXANDER_TRAIN_PROCESSES=4

# Parent models may be absolute paths, paths relative to the project root, or Hub IDs.
NINAXANDER_RWKV_MODEL=models/rwkv-raven-7b-hf-fp16
NINAXANDER_PYTHIA_MODEL=models/tulu-pythia69-fp16
NINAXANDER_TOKENIZER=EleutherAI/gpt-neox-20b

# Optional artifact/checkpoint overrides. Defaults are inside the project checkout.
# NINAXANDER_ARTIFACTS_DIR=/scratch/user/ninaxander/artifacts
# NINAXANDER_FINAL_ADAPTER=/scratch/user/SNAP_L32_final.pt
# NINAXANDER_SLURM_LOG_DIR=/scratch/user/ninaxander/logs/slurm
# NINAXANDER_EVAL_LOG_DIR=/scratch/user/ninaxander/logs/evaluation

# The training cache needs roughly 189 GiB for the reported run.
NINAXANDER_TRAIN_CACHE=/dev/shm/ninaxander_L32
NINAXANDER_OMP_THREADS=2

# Set 1 only after models, tokenizer, and datasets are cached locally.
NINAXANDER_HF_OFFLINE=0

# Optional for gated/private Hub resources.
# HF_TOKEN=
